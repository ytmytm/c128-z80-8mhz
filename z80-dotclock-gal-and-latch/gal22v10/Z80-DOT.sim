%SIGNAL
PIN   2 =  CLK1MHZ 
PIN   4 =  CLKIN 
PIN  23 =  CLKOUT 
PIN  18 =  CLOCKSEL 
PIN   3 =  DOTCLK 
PIN   6 = !IORQ 
PIN   5 = !MREQ 
PIN   7 = !RD 
PIN  16 = !RESET 
PIN   9 = !RFSH 
PIN  22 =  WAIT 
PIN  17 =  WAITLATCH 
PIN  20 =  WAITRESET 
PIN  21 =  WAITTRIGGER 
PIN   1 =  WAITTRIGGERIN 
PIN   8 = !WR 
%END

%FIELD
%END

%EQUATION
!CLKOUT =>
    !RESET
  # CLK1MHZ & CLOCKSEL
  # !CLKIN & !CLOCKSEL
  # CLOCKSEL & DOTCLK & MREQ
  # CLOCKSEL & DOTCLK & WR

!WAIT =>
    CLOCKSEL & !WAITLATCH

!WAITRESET =>
    CLK1MHZ & RESET

!WAITTRIGGER =>
    !RESET
  # !RFSH
  # IORQ & MREQ

CLKOUT.oe  =>
    1 

CLOCKSEL.oe  =>
    0 

RESET.oe  =>
    0 

WAIT.oe  =>
    1 

WAITLATCH.oe  =>
    0 

WAITRESET.oe  =>
    1 

WAITTRIGGER.oe  =>
    1 

%END
