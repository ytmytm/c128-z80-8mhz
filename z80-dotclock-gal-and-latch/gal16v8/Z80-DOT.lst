  8:Location  ;
  9:Device   G16V8 ;
 10:
 11:/* *************** INPUT PINS *********************/
 12:PIN 1   = WAITTRIGGERIN ;       /* routed from WAITTRIGGER */
 13:PIN 2   = CLK1MHZ       ;       /* U12 pin 11, Z80 is active on low phase of the system clock */
 14:PIN 3   = DOTCLK        ;       /* 8MHz dot clock from expansion port pin 6 or its multiplication */
 15:PIN 4   = CLKIN         ;       /* Z80 socket pin 6, original clock */
 16:PIN 5   = !MREQ         ;       /* Z80 pin 19, memory request */
 17:PIN 6   = !IORQ         ;       /* Z80 pin 20, I/O request */
 18:PIN 7   = !RD           ;       /* Z80 pin 21 */
 19:PIN 8   = !WR           ;       /* Z80 pin 22, (active one cycle later than MREQ, without delay with IORQ) */
 20:PIN 9   = !RFSH         ;       /* Z80 pin 28, if active: the MREQ request is memory refresh, ignore */
 21:PIN 12  = !RESET        ;       /* Z80 pin 26 */
 22:PIN 13  = WAITLATCH     ;       /* input: latched wait from 74'74 pin 6 */
 23:PIN 14  = CLOCKSEL      ;       /* jumper for clock selection: open (internal pullup) = FAST, closed to GND = SLOW */
 24:
 25:/* *************** OUTPUT PINS *********************/
 26:
 27:PIN 19  = CLKOUT        ;       /* Z80 pin 6, clock, 4/8 MHz half of the time */
 28:PIN 18  = WAIT          ;       /* Z80 pin 24 */
 29:PIN 17  = WAITTRIGGER   ;       /* output: trigger latch to hold WAITLATCH low, 74'74 pin 3 */
 30:PIN 16  = WAITRESET     ;       /* output: reset latch, 74'74 pin 1 */
 31:
 32:/** Logic Equations **/
 33:
 34:/* output 8MHz during CLK1MHZ low phase and no memory request */
 35:/* hold low during CLK1MHZ low phase and memory write request, until next 1MHz clock tick */
 36:/* output mainboard clock CLKIN if CLOCKSEL is grounded */
 37:
 38:CLKOUT = (!RESET &  CLOCKSEL & !CLK1MHZ & !MREQ & !WR & !DOTCLK ) 
 39:       # (!RESET &  CLOCKSEL & !CLK1MHZ & !MREQ &  WR & !DOTCLK )
 40:       # (!RESET &  CLOCKSEL & !CLK1MHZ &  MREQ &  WR )
 41:       # (!RESET &  CLOCKSEL & !CLK1MHZ &  MREQ & !WR & !DOTCLK )
 42:       # (!RESET & !CLOCKSEL & CLKIN )
 43:;
 44:
 45:/* reset latch when going into VIC phase, keep that line high during Z80 phase */
 46:WAITRESET = RESET # !CLK1MHZ;
 47:
 48:/* trigger latch on any address bus request: I/O or memory but not during memory refresh */
 49:WAITTRIGGER = !RESET & !RFSH & (MREQ # IORQ);
 50:
 51:/* copy latched wait status to Z80 /WAIT input or keep it high when slow mode is selected */
 52:WAIT = CLOCKSEL & WAITLATCH # !CLOCKSEL;
 53:

