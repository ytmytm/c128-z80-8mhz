  (text "GAL22V10 or GAL16V8\ncan be used in the same socket\n(align pin 1 to pin 1)"
    (at 251.46 114.935 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 01239f2c-b94e-4925-a1b4-2fd51c9ad2f0)
  )
  (text "CLK1MHZ from U12 pin 11 (same in C128/D/DCR)\nDOTCLK from Expansion port pin 6\n~{NMI} is optional, can be left unconnected "
    (at 95.885 19.05 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 13b6a677-93ba-4e63-9304-d4a2daa2f730)
  )
  (text "DOTCLK multiplier\nJP1/JP2 to choose multplication (see datasheet)\nleave open for 2x DOTCLK\n\nJP4 to choose 1x or multiplied DOTCLK"
    (at 114.3 187.96 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 6f81ee3e-bfa4-4c5a-b70f-7ad02ce9a17a)
  )
  (text "JP3 - GAL option: when closed pass ~{CLK_IN} when open pass ~{CLK_OUT} to Z80\n\nFast clock is enabled when:\n1) JP3 is open\n"
